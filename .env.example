# Единственная обязательная настройка. Получите токен у официального @BotFather.
# Храните его только в локальном .env оператора; пользователям токен не нужен.
# Если .env уже существует, изменяйте его, не заменяйте этим шаблоном.
BOT_TOKEN=

# Необязательно: Telegram ID администратора для закрытой команды /users.
# На доступ остальных пользователей к их личным библиотекам не влияет.
ADMIN_ID=

# Необязательно: диалог с DeepSeek через Yandex AI Studio.
# Секретное значение API-ключа (не его ID) хранится только у оператора.
# Запросы оплачиваются в Yandex AI Studio. Без настройки остальные функции работают.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=deepseek-v4-flash
# Число попыток запросов за сутки UTC, сохраняется при перезапуске.
AI_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100

# Начальный часовой пояс новых пользователей; по умолчанию московское время.
# Каждый пользователь может изменить свой пояс через /settings.
TIMEZONE=Europe/Moscow

# Общая локальная база с отдельными данными по Telegram ID пользователей.
# Путь относительно папки проекта. Сохраните прежний путь при обновлении.
DATABASE_PATH=data/assistant.sqlite3
