# Получите токен у официального @BotFather. Храните его только локально.
BOT_TOKEN=

# Числовой Telegram ID владельца. При пустом значении доступна только /id.
OWNER_ID=

# Часовой пояс по умолчанию; московское время.
TIMEZONE=Europe/Moscow

# Локальная база данных. Путь относительно папки проекта.
DATABASE_PATH=data/assistant.sqlite3
